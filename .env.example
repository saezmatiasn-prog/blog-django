# Copiá este archivo como .env y completá los valores.
# El archivo .env no se sube al repositorio.

# Clave secreta de Django. Podés generar una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=reemplazar-por-una-clave-secreta

# True para desarrollo local (necesario para ver las imágenes subidas)
DEBUG=True

# Hosts permitidos, separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1
